@model HomeAwayFromHome.DTOs.LoginApiRequest
@{ ViewData["Title"] = "Login"; }
<div class="container py-5" style="max-width:520px">
    <h1>Login</h1>
    <p class="text-muted">Sign in to Home Away From Home.</p>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    <form asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" type="password" /></div>
        <button class="btn btn-primary" type="submit">Login</button>
        <a asp-action="Register" class="btn btn-link">Create an account</a>
    </form>
</div>
