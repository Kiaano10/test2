@model IEnumerable<HomeAwayFromHome.Models.Review>

@{
    ViewData["Title"] = "Reviews";

    var averageRating = Model.Any()
        ? Model.Average(x => x.Rating)
        : 0;
}

<div class="management-page">

    <div class="management-header">

        <div>
            <span class="page-eyebrow">GUEST EXPERIENCE</span>
            <h1>Reviews</h1>
            <p>View and manage feedback from your guests.</p>
        </div>

        <a asp-action="Create" class="btn-primary-custom">
            <span>+</span> Add Review
        </a>

    </div>


    <div class="summary-row">

        <div class="summary-card">

            <span class="summary-label">
                TOTAL REVIEWS
            </span>

            <strong>
                @Model.Count()
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                AVERAGE RATING
            </span>

            <strong>
                ★ @averageRating.ToString("0.0") / 5
            </strong>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                PENDING
            </span>

            <strong>
                @Model.Count(x => x.Status == "Pending")
            </strong>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">★</div>

            <h3>No reviews yet</h3>

            <p>
                Guest reviews will appear here once they are recorded.
            </p>

        </div>
    }
    else
    {
        <div class="review-grid">

            @foreach (var item in Model)
            {
                <div class="review-card">

                    <div class="review-header">

                        <div>

                            <span class="review-booking">
                                Booking #@item.BookingID
                            </span>

                            <h2>
                                @(item.User?.Email ?? "Guest")
                            </h2>

                        </div>

                        <div class="rating">

                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="@(i <= item.Rating ? "star-active" : "star-inactive")">
                                    ★
                                </span>
                            }

                        </div>

                    </div>


                    <p class="review-comment">
                        "@item.Comment"
                    </p>


                    <div class="review-footer">

                        <span>
                            @item.CreatedAt.ToString("dd MMM yyyy")
                        </span>

                        <span class="status-badge
                            @(item.Status?.ToLower() == "approved"
                                ? "status-confirmed"
                                : "status-pending")">

                            @item.Status

                        </span>

                    </div>


                    <div class="review-actions">

                        <a asp-action="Details"
                           asp-route-id="@item.ReviewID">
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.ReviewID">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.ReviewID"
                           class="danger-link">
                            Delete
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>