@model HomeAwayFromHome.Models.Property

@{
    ViewData["Title"] = "Delete Property";
}

<div class="hafh-page">

    <div class="hafh-delete-container">

        <div class="hafh-delete-icon">
            !
        </div>

        <span class="hafh-eyebrow">DELETE PROPERTY</span>

        <h1>Delete Property?</h1>

        <p>
            Are you sure you want to permanently delete
            <strong>@Model.PropertyName</strong>?
        </p>

        <div class="hafh-delete-info">
            <div>
                <span>Property</span>
                <strong>@Model.PropertyName</strong>
            </div>

            <div>
                <span>Address</span>
                <strong>@Model.Address</strong>
            </div>
        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="PropertyID" />

            <div class="hafh-form-actions centered">
                <a asp-action="Index" class="hafh-btn hafh-btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="hafh-btn hafh-btn-danger">
                    Delete Property
                </button>
            </div>

        </form>

    </div>

</div>