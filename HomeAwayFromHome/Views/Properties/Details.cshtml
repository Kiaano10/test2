@model HomeAwayFromHome.Models.Property

@{
    ViewData["Title"] = "Property Details";
}

<div class="hafh-page">

    <div class="hafh-detail-header">
        <div>
            <span class="hafh-eyebrow">PROPERTY</span>
            <h1>@Model.PropertyName</h1>
            <p>@Model.Address</p>
        </div>

        <div class="hafh-detail-actions">
            <a asp-action="Edit" asp-route-id="@Model.PropertyID"
               class="hafh-btn hafh-btn-gold">
                Edit Property
            </a>

            <a asp-action="Index" class="hafh-btn hafh-btn-outline">
                Back
            </a>
        </div>
    </div>

    <div class="hafh-detail-card">

        <div class="hafh-detail-section">
            <h3>Property Information</h3>

            <div class="hafh-detail-grid">

                <div>
                    <span>Property Name</span>
                    <strong>@Model.PropertyName</strong>
                </div>

                <div>
                    <span>Address</span>
                    <strong>@Model.Address</strong>
                </div>

                <div>
                    <span>Bedrooms</span>
                    <strong>@Model.Bedrooms</strong>
                </div>

                <div>
                    <span>Bathrooms</span>
                    <strong>@Model.Bathrooms</strong>
                </div>

                <div>
                    <span>Maximum Guests</span>
                    <strong>@Model.MaximumGuests</strong>
                </div>

                <div>
                    <span>Price Per Night</span>
                    <strong>R @Model.PricePerNight</strong>
                </div>

            </div>
        </div>

        <div class="hafh-detail-section">
            <h3>Description</h3>
            <p class="hafh-description">
                @Model.Description
            </p>
        </div>

    </div>
</div>