@model IEnumerable<HomeAwayFromHome.Models.Property>

@{
    ViewData["Title"] = "Properties";
}

<div class="management-page">

    <div class="management-header">
        <div>
            <span class="page-eyebrow">PROPERTY MANAGEMENT</span>
            <h1>Properties</h1>
            <p>Manage your accommodation properties and their details.</p>
        </div>

        <a asp-action="Create" class="btn-primary-custom">
            <span>+</span> Add Property
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">⌂</div>
            <h3>No properties yet</h3>
            <p>Start by adding your first property.</p>
            <a asp-action="Create" class="btn-primary-custom">Add Property</a>
        </div>
    }
    else
    {
        <div class="property-grid">

            @foreach (var item in Model)
            {
                <div class="property-card">

                    <div class="property-card-top">
                        <div class="property-icon">⌂</div>

                        <div class="property-actions">
                            <a asp-action="Details"
                               asp-route-id="@item.PropertyID"
                               title="View details">
                                View
                            </a>
                        </div>
                    </div>

                    <div class="property-card-body">

                        <h2>@item.PropertyName</h2>

                        <p class="property-address">
                            @item.Address
                        </p>

                        <p class="property-description">
                            @item.Description
                        </p>

                        <div class="property-stats">

                            <div>
                                <strong>@item.Bedrooms</strong>
                                <span>Bedrooms</span>
                            </div>

                            <div>
                                <strong>@item.Bathrooms</strong>
                                <span>Bathrooms</span>
                            </div>

                            <div>
                                <strong>@item.MaximumGuests</strong>
                                <span>Guests</span>
                            </div>

                        </div>

                        <div class="property-price">
                            <strong>R @item.PricePerNight.ToString("N2")</strong>
                            <span>per night</span>
                        </div>

                    </div>

                    <div class="property-card-footer">

                        <a asp-action="Edit"
                           asp-route-id="@item.PropertyID"
                           class="action-edit">
                            Edit
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.PropertyID"
                           class="action-view">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.PropertyID"
                           class="action-delete">
                            Delete
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>