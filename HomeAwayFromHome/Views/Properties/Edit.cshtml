@model HomeAwayFromHome.Models.Property

@{
    ViewData["Title"] = "Edit Property";
}

<div class="hafh-page">
    <div class="hafh-form-container">

        <div class="hafh-form-header">
            <div>
                <span class="hafh-eyebrow">PROPERTY MANAGEMENT</span>
                <h1>Edit Property</h1>
                <p>Update the property information below.</p>
            </div>

            <a asp-action="Index" class="hafh-btn hafh-btn-outline">
                ← Back to Properties
            </a>
        </div>

        <form asp-action="Edit">

            <input type="hidden" asp-for="PropertyID" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="hafh-form-grid">

                <div class="hafh-form-group">
                    <label asp-for="PropertyName"></label>
                    <input asp-for="PropertyName" class="form-control" />
                    <span asp-validation-for="PropertyName" class="text-danger"></span>
                </div>

                <div class="hafh-form-group">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="hafh-form-group full-width">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="hafh-form-group">
                    <label asp-for="Bedrooms"></label>
                    <input asp-for="Bedrooms" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Bedrooms" class="text-danger"></span>
                </div>

                <div class="hafh-form-group">
                    <label asp-for="Bathrooms"></label>
                    <input asp-for="Bathrooms" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Bathrooms" class="text-danger"></span>
                </div>

                <div class="hafh-form-group">
                    <label asp-for="MaximumGuests"></label>
                    <input asp-for="MaximumGuests" class="form-control" type="number" min="1" />
                    <span asp-validation-for="MaximumGuests" class="text-danger"></span>
                </div>

                <div class="hafh-form-group">
                    <label asp-for="PricePerNight"></label>
                    <div class="hafh-input-prefix">
                        <span>R</span>
                        <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>

            </div>

            <div class="hafh-form-actions">
                <a asp-action="Index" class="hafh-btn hafh-btn-secondary">Cancel</a>
                <button type="submit" class="hafh-btn hafh-btn-gold">
                    Save Changes
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}