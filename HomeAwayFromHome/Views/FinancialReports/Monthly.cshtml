@model HomeAwayFromHome.ViewModels.MonthlyFinancialReport
@{ViewData["Title"]="Monthly P&L";}
<div class="container py-4"><h1>Monthly Profit & Loss</h1><p>@Model.Month/@Model.Year</p><div class="row"><div class="col-md-4"><div class="card p-3"><small>Income</small><h2>R @Model.TotalIncome.ToString("N2")</h2></div></div><div class="col-md-4"><div class="card p-3"><small>Expenses</small><h2>R @Model.TotalExpenses.ToString("N2")</h2></div></div><div class="col-md-4"><div class="card p-3"><small>Profit/Loss</small><h2>R @Model.Profit.ToString("N2")</h2></div></div></div><a asp-action="Annual" class="btn btn-outline-primary mt-3">Annual Report</a></div>