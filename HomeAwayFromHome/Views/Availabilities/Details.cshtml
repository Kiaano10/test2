@model HomeAwayFromHome.Models.Amenity

@{
    ViewData["Title"] = "Amenity Details";
}

<div class="hafh-page">

    <div class="hafh-detail-header">
        <div>
            <span class="hafh-eyebrow">AMENITY</span>
            <h1>@Model.Name</h1>
            <p>Amenity details</p>
        </div>

        <div class="hafh-detail-actions">
            <a asp-action="Edit" asp-route-id="@Model.AmenityID"
               class="hafh-btn hafh-btn-gold">
                Edit
            </a>

            <a asp-action="Index" class="hafh-btn hafh-btn-outline">
                Back
            </a>
        </div>
    </div>

    <div class="hafh-detail-card">

        <div class="hafh-detail-section">
            <h3>Amenity Information</h3>

            <div class="hafh-detail-grid">

                <div>
                    <span>ID</span>
                    <strong>@Model.AmenityID</strong>
                </div>

                <div>
                    <span>Name</span>
                    <strong>@Model.Name</strong>
                </div>

            </div>
        </div>

        <div class="hafh-detail-section">
            <h3>Description</h3>
            <p class="hafh-description">
                @Model.Description
            </p>
        </div>

    </div>
</div>