@model HomeAwayFromHome.Models.Amenity

@{
    ViewData["Title"] = "Edit Amenity";
}

<div class="hafh-page">
    <div class="hafh-form-container">

        <div class="hafh-form-header">
            <div>
                <span class="hafh-eyebrow">AMENITIES</span>
                <h1>Edit Amenity</h1>
                <p>Update the amenity information.</p>
            </div>

            <a asp-action="Index" class="hafh-btn hafh-btn-outline">
                ← Back
            </a>
        </div>

        <form asp-action="Edit">

            <input type="hidden" asp-for="AmenityID" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="hafh-form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="hafh-form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control"
                          rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="hafh-form-actions">
                <a asp-action="Index" class="hafh-btn hafh-btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="hafh-btn hafh-btn-gold">
                    Save Changes
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}