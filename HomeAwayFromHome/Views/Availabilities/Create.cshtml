@model HomeAwayFromHome.Models.Availability

@{
    ViewData["Title"] = "Add Availability";
}

<div class="hafh-page">

    <div class="hafh-form-container">

        <div class="hafh-form-header">
            <div>
                <span class="hafh-eyebrow">PROPERTY CALENDAR</span>
                <h1>Add Availability</h1>
                <p>Create an availability period for a property.</p>
            </div>

            <a asp-action="Index" class="hafh-btn hafh-btn-outline">
                ← Back
            </a>
        </div>


        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>


            <!-- PROPERTY -->

            <div class="hafh-form-group">

                <label asp-for="PropertyID">
                    Property
                </label>

                <select asp-for="PropertyID"
                        class="form-control">

                    <option value="0">
                        Select a property
                    </option>

                    @if (ViewBag.Properties != null)
                    {
                        foreach (var property in ViewBag.Properties)
                        {
                            <option value="@property.PropertyID">
                                @property.PropertyName
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="PropertyID"
                      class="text-danger"></span>

                <small class="form-help">
                    Select the property this availability period applies to.
                </small>

            </div>


            <!-- DATE RANGE -->

            <div class="hafh-form-row">

                <div class="hafh-form-group">

                    <label asp-for="AvailableFrom">
                        Available From
                    </label>

                    <input asp-for="AvailableFrom"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="AvailableFrom"
                          class="text-danger"></span>

                </div>


                <div class="hafh-form-group">

                    <label asp-for="AvailableTo">
                        Available To
                    </label>

                    <input asp-for="AvailableTo"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="AvailableTo"
                          class="text-danger"></span>

                </div>

            </div>


            <!-- STATUS -->

            <div class="hafh-form-group">

                <label asp-for="Status">
                    Availability Status
                </label>

                <select asp-for="Status"
                        class="form-control">

                    <option value="Available">
                        Available
                    </option>

                    <option value="Unavailable">
                        Unavailable
                    </option>

                </select>

                <span asp-validation-for="Status"
                      class="text-danger"></span>

                <small class="form-help">
                    Set whether the property can currently be booked during this period.
                </small>

            </div>


            <!-- ACTIONS -->

            <div class="hafh-form-actions">

                <a asp-action="Index"
                   class="hafh-btn hafh-btn-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="hafh-btn hafh-btn-gold">
                    Add Availability
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .hafh-page {
        min-height: calc(100vh - 160px);
        padding: 50px 24px;
        background: #f7f8fb;
    }

    .hafh-form-container {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 18px;
        padding: 40px;
        box-shadow: 0 10px 35px rgba(11, 31, 58, 0.08);
        border: 1px solid #e8ebf0;
    }

    .hafh-form-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
        margin-bottom: 35px;
        padding-bottom: 25px;
        border-bottom: 1px solid #e8ebf0;
    }

    .hafh-eyebrow {
        display: block;
        color: #c9a227;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .hafh-form-header h1 {
        margin: 0 0 8px;
        color: #0b1f3a;
        font-size: 2rem;
        font-weight: 700;
    }

    .hafh-form-header p {
        margin: 0;
        color: #6b7280;
        font-size: 0.95rem;
    }

    .hafh-form-group {
        margin-bottom: 25px;
    }

    .hafh-form-group label {
        display: block;
        margin-bottom: 8px;
        color: #0b1f3a;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #d9dee7;
        border-radius: 9px;
        background: #ffffff;
        color: #0b1f3a;
        font-size: 0.95rem;
        box-sizing: border-box;
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .form-control:focus {
        border-color: #c9a227;
        box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
        outline: none;
    }

    select.form-control {
        cursor: pointer;
    }

    .form-help {
        display: block;
        margin-top: 7px;
        color: #7a8290;
        font-size: 0.8rem;
    }

    .hafh-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .hafh-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #e8ebf0;
    }

    .hafh-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .hafh-btn-gold {
        background: #c9a227;
        color: #ffffff;
    }

    .hafh-btn-gold:hover {
        background: #ad8b1e;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .hafh-btn-outline {
        background: #ffffff;
        color: #0b1f3a;
        border: 1px solid #d9dee7;
    }

    .hafh-btn-outline:hover {
        background: #f7f8fb;
        color: #0b1f3a;
        border-color: #0b1f3a;
    }

    .hafh-btn-secondary {
        background: #eef1f5;
        color: #0b1f3a;
    }

    .hafh-btn-secondary:hover {
        background: #e2e6ec;
        color: #0b1f3a;
    }

    .text-danger {
        display: block;
        margin-top: 6px;
        color: #b42318 !important;
        font-size: 0.82rem;
    }


    @@media (max-width: 650px) {

        .hafh-page {
            padding: 30px 15px;
        }

        .hafh-form-container {
            padding: 25px 20px;
            border-radius: 14px;
        }

        .hafh-form-header {
            flex-direction: column;
            margin-bottom: 25px;
        }

        .hafh-form-header h1 {
            font-size: 1.6rem;
        }

        .hafh-form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .hafh-form-actions {
            flex-direction: column-reverse;
        }

        .hafh-form-actions .hafh-btn {
            width: 100%;
        }

    }

</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}