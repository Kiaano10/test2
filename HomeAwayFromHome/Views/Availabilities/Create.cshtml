@model HomeAwayFromHome.Models.Amenity

@{
    ViewData["Title"] = "Add Amenity";
}

<div class="hafh-page">
    <div class="hafh-form-container">

        <div class="hafh-form-header">
            <div>
                <span class="hafh-eyebrow">AMENITIES</span>
                <h1>Add Amenity</h1>
                <p>Add a facility or service available to guests.</p>
            </div>

            <a asp-action="Index" class="hafh-btn hafh-btn-outline">
                ← Back
            </a>
        </div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="hafh-form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control"
                       placeholder="e.g. Swimming Pool" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="hafh-form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control"
                          rows="5"
                          placeholder="Describe the amenity"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="hafh-form-actions">
                <a asp-action="Index" class="hafh-btn hafh-btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="hafh-btn hafh-btn-gold">
                    Add Amenity
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}