@model HomeAwayFromHome.Models.Amenity

@{
    ViewData["Title"] = "Delete Amenity";
}

<div class="hafh-page">

    <div class="hafh-delete-container">

        <div class="hafh-delete-icon">!</div>

        <span class="hafh-eyebrow">DELETE AMENITY</span>

        <h1>Delete Amenity?</h1>

        <p>
            Are you sure you want to delete
            <strong>@Model.Name</strong>?
        </p>

        <form asp-action="Delete">

            <input type="hidden" asp-for="AmenityID" />

            <div class="hafh-form-actions centered">

                <a asp-action="Index"
                   class="hafh-btn hafh-btn-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="hafh-btn hafh-btn-danger">
                    Delete Amenity
                </button>

            </div>

        </form>

    </div>

</div>