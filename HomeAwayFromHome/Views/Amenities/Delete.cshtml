@model HomeAwayFromHome.Models.Amenity

@{
    ViewData["Title"] = "Delete Amenity";
}

<style>
    .amenity-delete-page {
        min-height: calc(100vh - 160px);
        background: #f7f8fb;
        padding: 50px 0 70px;
    }

    .amenity-delete-container {
        max-width: 700px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #536174;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 22px;
    }

    .back-link:hover {
        color: #0b1f3a;
        text-decoration: none;
    }

    .delete-card {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 15px;
        box-shadow: 0 7px 25px rgba(11, 31, 58, 0.08);
        overflow: hidden;
    }

    .delete-header {
        background: #0b1f3a;
        color: #ffffff;
        padding: 30px;
        text-align: center;
    }

    .warning-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #c9a227;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 1.45rem;
        font-weight: 700;
    }

    .delete-header h1 {
        margin: 0 0 7px;
        font-size: 1.65rem;
        font-weight: 700;
    }

    .delete-header p {
        margin: 0;
        color: #d6dce4;
        font-size: 0.9rem;
    }

    .delete-body {
        padding: 30px;
    }

    .warning-message {
        background: #fff9e8;
        border: 1px solid #eadba7;
        border-radius: 8px;
        padding: 14px 16px;
        color: #6e5a1b;
        font-size: 0.88rem;
        line-height: 1.5;
        margin-bottom: 25px;
    }

    .amenity-summary {
        border: 1px solid #e2e6eb;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 28px;
    }

    .summary-label {
        display: block;
        color: #8a929d;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        font-size: 0.74rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .summary-name {
        color: #0b1f3a;
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 15px;
    }

    .summary-description {
        color: #596575;
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
    }

    .no-description {
        color: #8a929d;
        font-style: italic;
    }

    .delete-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        border-top: 1px solid #e7eaf0;
        padding-top: 25px;
    }

    .cancel-button {
        display: inline-block;
        padding: 11px 19px;
        border: 1px solid #cfd5dd;
        border-radius: 7px;
        color: #39485b;
        background: #ffffff;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .cancel-button:hover {
        background: #f4f6f8;
        color: #0b1f3a;
        text-decoration: none;
    }

    .delete-button {
        border: none;
        border-radius: 7px;
        padding: 12px 22px;
        background: #a63838;
        color: #ffffff;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .delete-button:hover {
        background: #892d2d;
    }

    @@media (max-width: 600px) {
        .amenity-delete-page {
            padding: 35px 0 50px;
        }

        .delete-body {
            padding: 24px 20px;
        }

        .delete-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .cancel-button,
        .delete-button {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }
    }
</style>

<div class="amenity-delete-page">

    <div class="amenity-delete-container">

        <a asp-action="Index"
           class="back-link">
            ← Back to Amenities
        </a>

        <div class="delete-card">

            <div class="delete-header">

                <div class="warning-icon">
                    !
                </div>

                <h1>Delete Amenity?</h1>

                <p>
                    Please confirm that you want to remove this amenity.
                </p>

            </div>

            <div class="delete-body">

                <div class="warning-message">
                    <strong>This action cannot be undone.</strong>
                    The amenity will be removed from the system.
                    If it is currently assigned to a property, the system
                    may prevent the deletion.
                </div>

                <div class="amenity-summary">

                    <span class="summary-label">
                        Amenity
                    </span>

                    <h2 class="summary-name">
                        @Model.Name
                    </h2>

                    <span class="summary-label">
                        Description
                    </span>

                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="summary-description no-description">
                            No description provided.
                        </p>
                    }
                    else
                    {
                        <p class="summary-description">
                            @Model.Description
                        </p>
                    }

                </div>

                <div class="delete-actions">

                    <a asp-action="Index"
                       class="cancel-button">
                        Cancel
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@Model.AmenityID"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to permanently delete this amenity?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="AmenityID" />

                        <button type="submit"
                                class="delete-button">
                            Delete Amenity
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>