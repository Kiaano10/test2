@model IEnumerable<HomeAwayFromHome.Models.Amenity>

@{
    ViewData["Title"] = "Amenities";
}

<div class="management-page">

    <div class="management-header">

        <div>
            <span class="page-eyebrow">PROPERTY FEATURES</span>
            <h1>Amenities</h1>
            <p>Manage the facilities and features available to guests.</p>
        </div>

        <a asp-action="Create" class="btn-primary-custom">
            <span>+</span> Add Amenity
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">✦</div>

            <h3>No amenities yet</h3>

            <p>
                Add amenities such as Wi-Fi, parking, swimming pool
                or other facilities.
            </p>

            <a asp-action="Create" class="btn-primary-custom">
                Add Amenity
            </a>

        </div>
    }
    else
    {
        <div class="amenity-grid">

            @foreach (var item in Model)
            {
                <div class="amenity-card">

                    <div class="amenity-icon">
                        ✦
                    </div>

                    <div class="amenity-content">

                        <h2>@item.Name</h2>

                        <p>
                            @item.Description
                        </p>

                    </div>

                    <div class="amenity-footer">

                        <a asp-action="Edit"
                           asp-route-id="@item.AmenityID">
                            Edit
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.AmenityID">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.AmenityID"
                           class="danger-link">
                            Delete
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>