@model IEnumerable<HomeAwayFromHome.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<style>
    .bookings-page {
        min-height: calc(100vh - 160px);
        background: #f7f8fb;
        padding: 45px 0 70px;
    }

    .bookings-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .bookings-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .bookings-title-area h1 {
        color: #0b1f3a;
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0 0 8px;
    }

    .bookings-title-area p {
        color: #6c7480;
        margin: 0;
        font-size: 0.98rem;
    }

    .create-booking-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #c9a227;
        color: #ffffff;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.2s ease;
        white-space: nowrap;
    }

    .create-booking-btn:hover {
        background: #b18d1f;
        color: #ffffff;
        text-decoration: none;
        transform: translateY(-1px);
    }

    .success-message,
    .error-message {
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 22px;
        font-size: 0.95rem;
    }

    .success-message {
        background: #e9f7ef;
        color: #17663a;
        border: 1px solid #bfe5ce;
    }

    .error-message {
        background: #fdecec;
        color: #8a2525;
        border: 1px solid #f2c5c5;
    }

    .booking-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
        gap: 22px;
    }

    .booking-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #e4e7ec;
        box-shadow: 0 5px 18px rgba(11, 31, 58, 0.07);
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .booking-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 9px 25px rgba(11, 31, 58, 0.11);
    }

    .booking-card-header {
        background: #0b1f3a;
        color: #ffffff;
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .booking-id {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #d7dce3;
    }

    .booking-property {
        font-size: 1.18rem;
        font-weight: 700;
        margin-top: 4px;
    }

    .booking-status {
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
        background: #ffffff;
        color: #0b1f3a;
    }

    .booking-card-body {
        padding: 22px;
    }

    .booking-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 20px;
        margin-bottom: 22px;
    }

    .detail-label {
        display: block;
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #8a929d;
        margin-bottom: 4px;
    }

    .detail-value {
        color: #25364d;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .booking-total {
        border-top: 1px solid #e8ebef;
        padding-top: 16px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .booking-total span:first-child {
        color: #6c7480;
        font-size: 0.9rem;
    }

    .booking-total strong {
        color: #0b1f3a;
        font-size: 1.2rem;
    }

    .booking-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .booking-action {
        flex: 1;
        min-width: 120px;
        text-align: center;
        padding: 10px 14px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .view-action {
        background: #0b1f3a;
        color: #ffffff;
    }

    .view-action:hover {
        background: #162f50;
        color: #ffffff;
        text-decoration: none;
    }

    .cancel-action {
        background: #ffffff;
        color: #9a3434;
        border: 1px solid #d8aaaa;
        cursor: pointer;
    }

    .cancel-action:hover {
        background: #fdf0f0;
        color: #842828;
    }

    .empty-bookings {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 14px;
        padding: 55px 25px;
        text-align: center;
        box-shadow: 0 5px 18px rgba(11, 31, 58, 0.05);
    }

    .empty-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .empty-bookings h2 {
        color: #0b1f3a;
        font-size: 1.45rem;
        margin-bottom: 8px;
    }

    .empty-bookings p {
        color: #737b86;
        margin-bottom: 22px;
    }

    .validation-summary {
        margin-bottom: 20px;
        color: #8a2525;
    }

    @@media (max-width: 700px) {
        .bookings-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .create-booking-btn {
            width: 100%;
            justify-content: center;
        }

        .booking-grid {
            grid-template-columns: 1fr;
        }

        .booking-details {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="bookings-page">
    <div class="bookings-container">

        <div class="bookings-header">
            <div class="bookings-title-area">
                <h1>My Bookings</h1>
                <p>View and manage your Home Away From Home reservations.</p>
            </div>

            <a asp-controller="Bookings"
               asp-action="Create"
               class="create-booking-btn">
                + New Booking
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="success-message">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="error-message">
                @TempData["Error"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                @Html.ValidationSummary(false)
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="booking-grid">

                @foreach (var item in Model)
                {
                    <div class="booking-card">

                        <div class="booking-card-header">
                            <div>
                                <div class="booking-id">
                                    Booking #@item.BookingID
                                </div>

                                <div class="booking-property">
                                    @(item.Property?.PropertyName ?? "Property")
                                </div>
                            </div>

                            <div class="booking-status">
                                @(string.IsNullOrWhiteSpace(item.Status)
                                    ? "Pending"
                                    : item.Status)
                            </div>
                        </div>

                        <div class="booking-card-body">

                            <div class="booking-details">

                                <div>
                                    <span class="detail-label">Check-in</span>
                                    <span class="detail-value">
                                        @item.CheckInDate.ToString("dd MMM yyyy")
                                    </span>
                                </div>

                                <div>
                                    <span class="detail-label">Check-out</span>
                                    <span class="detail-value">
                                        @item.CheckOutDate.ToString("dd MMM yyyy")
                                    </span>
                                </div>

                                <div>
                                    <span class="detail-label">Guests</span>
                                    <span class="detail-value">
                                        @item.NumberOfGuests
                                    </span>
                                </div>

                                <div>
                                    <span class="detail-label">Booked</span>
                                    <span class="detail-value">
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                    </span>
                                </div>

                            </div>

                            <div class="booking-total">
                                <span>Total amount</span>

                                <strong>
                                    R @item.TotalAmount.ToString("N2")
                                </strong>
                            </div>

                            <div class="booking-actions">

                                <!-- IMPORTANT:
                                     Use "id", not "bookingid".
                                     The controller action is Details(int id).
                                -->
                                <a asp-controller="Bookings"
                                   asp-action="Details"
                                   asp-route-id="@item.BookingID"
                                   class="booking-action view-action">
                                    View Details
                                </a>

                                @if (!string.Equals(item.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
                                    && !string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-controller="Bookings"
                                          asp-action="Cancel"
                                          asp-route-id="@item.BookingID"
                                          method="post"
                                          style="flex: 1; min-width: 120px;"
                                          onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="booking-action cancel-action"
                                                style="width: 100%;">
                                            Cancel Booking
                                        </button>
                                    </form>
                                }

                            </div>

                        </div>
                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-bookings">

                <div class="empty-icon">🏡</div>

                <h2>No bookings yet</h2>

                <p>
                    You don't have any bookings yet.
                    Find a property and make your first reservation.
                </p>

                <a asp-controller="Bookings"
                   asp-action="Create"
                   class="create-booking-btn">
                    Make a Booking
                </a>

            </div>
        }

    </div>
</div>