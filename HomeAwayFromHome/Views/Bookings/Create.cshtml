@model HomeAwayFromHome.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* =========================================
           HOME AWAY FROM HOME - BOOKING FORM
           ========================================= */

    .booking-page {
        min-height: calc(100vh - 80px);
        background: #f5f6f8;
        padding: 50px 25px 70px;
    }

    .booking-container {
        max-width: 1050px;
        margin: 0 auto;
    }

    /* PAGE HEADER */

    .booking-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 30px;
    }

    .booking-heading-left {
        max-width: 650px;
    }

    .booking-eyebrow {
        display: inline-block;
        color: #b98728;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .booking-heading h1 {
        margin: 0;
        color: #172033;
        font-size: 2.15rem;
        font-weight: 750;
        letter-spacing: -0.5px;
    }

    .booking-heading p {
        margin: 8px 0 0;
        color: #697386;
        font-size: 0.98rem;
    }

    /* BACK BUTTON */

    .booking-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border: 1px solid #d5dae2;
        border-radius: 9px;
        background: #ffffff;
        color: #172033 !important;
        text-decoration: none !important;
        font-size: 0.88rem;
        font-weight: 650;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .booking-back:hover {
            background: #172033;
            border-color: #172033;
            color: #ffffff !important;
            transform: translateY(-1px);
        }

    /* MAIN CARD */

    .booking-card {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(23, 32, 51, 0.07);
        overflow: hidden;
    }

    .booking-card-top {
        padding: 30px 35px 25px;
        border-bottom: 1px solid #edf0f4;
    }

    .booking-card-title {
        margin: 0;
        color: #172033;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .booking-card-subtitle {
        margin: 5px 0 0;
        color: #7a8391;
        font-size: 0.88rem;
    }

    /* FORM */

    .booking-form {
        padding: 35px;
    }

    .booking-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 25px 28px;
    }

    .booking-field {
        min-width: 0;
    }

        .booking-field.full {
            grid-column: 1 / -1;
        }

        .booking-field label {
            display: block;
            margin-bottom: 8px;
            color: #253047;
            font-size: 0.88rem;
            font-weight: 700;
        }

        .booking-field .form-control {
            width: 100%;
            min-height: 48px;
            padding: 11px 14px;
            border: 1px solid #d7dce4;
            border-radius: 9px;
            background: #ffffff;
            color: #172033;
            font-size: 0.94rem;
            box-shadow: none;
            transition: all 0.2s ease;
        }

            .booking-field .form-control:hover {
                border-color: #bfc6d1;
            }

            .booking-field .form-control:focus {
                border-color: #e2ae45;
                outline: none;
                box-shadow: 0 0 0 3px rgba(226, 174, 69, 0.14);
            }

        /* SELECTS */

        .booking-field select.form-control {
            cursor: pointer;
        }

        /* DATE INPUTS */

        .booking-field input[type="date"].form-control {
            min-height: 48px;
        }

    /* CURRENCY */

    .amount-input {
        position: relative;
    }

    .amount-symbol {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #697386;
        font-size: 0.92rem;
        font-weight: 700;
        z-index: 2;
        pointer-events: none;
    }

    .amount-input .form-control {
        padding-left: 32px;
    }

    /* CREATED DATE */

    .booking-readonly {
        background: #f5f6f8 !important;
        color: #697386 !important;
    }

    /* VALIDATION */

    .booking-validation {
        background: #fff5f4;
        border: 1px solid #f2c7c3;
        border-radius: 9px;
        padding: 13px 16px;
        margin-bottom: 25px;
        color: #9f2d25;
        font-size: 0.88rem;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #b42318;
        font-size: 0.78rem;
    }

    /* FORM FOOTER */

    .booking-form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #edf0f4;
    }

    /* BUTTONS */

    .booking-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 10px 21px;
        border-radius: 9px;
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration: none !important;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .booking-btn-cancel {
        background: #f0f2f5;
        border-color: #e0e3e8;
        color: #303949 !important;
    }

        .booking-btn-cancel:hover {
            background: #e4e7ec;
            color: #172033 !important;
        }

    .booking-btn-submit {
        background: #e9b44c;
        border-color: #e9b44c;
        color: #172033 !important;
        box-shadow: 0 4px 12px rgba(233, 180, 76, 0.2);
    }

        .booking-btn-submit:hover {
            background: #dca63e;
            border-color: #dca63e;
            color: #172033 !important;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(233, 180, 76, 0.25);
        }

    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .booking-page {
            padding: 30px 15px 50px;
        }

        .booking-heading {
            flex-direction: column;
            align-items: flex-start;
        }

            .booking-heading h1 {
                font-size: 1.8rem;
            }

        .booking-back {
            width: 100%;
            justify-content: center;
        }

        .booking-card-top,
        .booking-form {
            padding: 25px 20px;
        }

        .booking-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .booking-field.full {
            grid-column: auto;
        }

        .booking-form-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .booking-btn {
            width: 100%;
        }
    }
</style>


<div class="booking-page">

    <div class="booking-container">

        <!-- PAGE HEADER -->
        <div class="booking-heading">

            <div class="booking-heading-left">

                <span class="booking-eyebrow">
                    BOOKING MANAGEMENT
                </span>

                <h1>Create New Booking</h1>

                <p>
                    Create a reservation and capture the guest's
                    booking details.
                </p>

            </div>

            <a asp-action="Index" class="booking-back">
                <span>←</span>
                <span>Back to Bookings</span>
            </a>

        </div>


        <!-- FORM CARD -->
        <div class="booking-card">

            <div class="booking-card-top">

                <h2 class="booking-card-title">
                    Booking Information
                </h2>

                <p class="booking-card-subtitle">
                    Enter the property, dates, guests and payment details.
                </p>

            </div>


            <form asp-action="Create" class="booking-form">

                <div asp-validation-summary="ModelOnly"
                     class="booking-validation"></div>


                <div class="booking-grid">

                    <!-- PROPERTY -->

                    <div class="booking-field full">

                        <label asp-for="PropertyID">
                            Property
                        </label>

                        <select asp-for="PropertyID"
                                class="form-control"
                                asp-items="ViewBag.PropertyID">

                            <option value="">
                                Select a property
                            </option>

                        </select>

                        <span asp-validation-for="PropertyID"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- CHECK IN -->

                    <div class="booking-field">

                        <label asp-for="CheckInDate">
                            Check-in Date
                        </label>

                        <input asp-for="CheckInDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="CheckInDate"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- CHECK OUT -->

                    <div class="booking-field">

                        <label asp-for="CheckOutDate">
                            Check-out Date
                        </label>

                        <input asp-for="CheckOutDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="CheckOutDate"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- GUESTS -->

                    <div class="booking-field">

                        <label asp-for="NumberOfGuests">
                            Number of Guests
                        </label>

                        <input asp-for="NumberOfGuests"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="e.g. 2" />

                        <span asp-validation-for="NumberOfGuests"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- TOTAL AMOUNT -->

                    <div class="booking-field">

                        <label asp-for="TotalAmount">
                            Total Amount
                        </label>

                        <div class="amount-input">

                            <span class="amount-symbol">
                                R
                            </span>

                            <input asp-for="TotalAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="TotalAmount"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- STATUS -->

                    <div class="booking-field">

                        <label asp-for="Status">
                            Booking Status
                        </label>

                        <select asp-for="Status"
                                class="form-control">

                            <option value="">
                                Select status
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Confirmed">
                                Confirmed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="field-validation-error">
                        </span>

                    </div>


                    <!-- CREATED DATE -->

                    <div class="booking-field">

                        <label asp-for="CreatedAt">
                            Booking Created
                        </label>

                        <input asp-for="CreatedAt"
                               type="datetime-local"
                               class="form-control booking-readonly" />

                        <span asp-validation-for="CreatedAt"
                              class="field-validation-error">
                        </span>

                    </div>

                </div>


                <!-- FORM BUTTONS -->

                <div class="booking-form-footer">

                    <a asp-action="Index"
                       class="booking-btn booking-btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="booking-btn booking-btn-submit">
                        Create Booking
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}